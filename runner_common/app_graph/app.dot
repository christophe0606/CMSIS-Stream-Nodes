  <TR>
    <TD PORT="i"><FONT POINT-SIZE="12.0" COLOR="black">i</FONT></TD>
    <TD ALIGN="CENTER" ROWSPAN="2"><FONT COLOR="black" POINT-SIZE="14.0">spectrogram<BR/>(Spectrogram)</FONT></TD>
    <TD PORT="oev0"><FONT POINT-SIZE="12.0" COLOR="black">oev0</FONT></TD>
  </TR>
<TR>
 
<TD></TD>
 
<TD></TD></TR>

</TABLE>>];

